{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Emit a buildable, composite project so consuming services can reference
    // this package via TypeScript project references and type-check against its
    // generated declaration files.
    "composite": true,
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
