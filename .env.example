# =============================================================================
# PAWAAC Drone Fleet Operations Platform — Environment Variable Reference
# =============================================================================
# Copy this file to `.env` and replace every CHANGE_ME value with a real one:
#
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NEVER be committed (Requirement 31.3). This
# `.env.example` documents EVERY variable consumed by docker-compose.yml and the
# services it orchestrates. Values shown here are safe, non-secret placeholders
# intended for local development only — generate strong, unique secrets for any
# shared or production-like environment.
#
# Bring the platform up with fail-fast semantics (Requirement 26.3):
#     docker compose up --build --wait --abort-on-container-failure
# =============================================================================

# -----------------------------------------------------------------------------
# Global / cross-cutting
# -----------------------------------------------------------------------------
NODE_ENV=production
LOG_LEVEL=info
# Header used to propagate the distributed trace id across services (Req 34.3).
TRACE_HEADER=X-Trace-Id

# -----------------------------------------------------------------------------
# Authentication (API Gateway — Req 18)
# -----------------------------------------------------------------------------
# Secret used to sign/verify JWTs at the gateway. Use a long random string.
JWT_SECRET=CHANGE_ME_super_secret_jwt_signing_key
JWT_EXPIRES_IN=1h

# Per-drone shared token that drones present when opening the telemetry WS.
DRONE_AUTH_TOKEN=CHANGE_ME_drone_ws_auth_token

# -----------------------------------------------------------------------------
# Service ports (host-published; container ports are fixed)
# -----------------------------------------------------------------------------
API_GATEWAY_PORT=3000
FLEET_REGISTRY_PORT=3001
MISSION_PLANNING_PORT=3002
TELEMETRY_INGESTION_PORT=3003
ALERT_NOTIFICATION_PORT=3005
VISION_AI_PORT=8000
OPS_DASHBOARD_PORT=3006

# -----------------------------------------------------------------------------
# Datastore host-published ports (for local inspection only; in-network the
# services reach datastores on 5432/6379 via the compose network)
# -----------------------------------------------------------------------------
FLEET_DB_HOST_PORT=5432
MISSION_DB_HOST_PORT=5433
VISION_DB_HOST_PORT=5434
ALERT_DB_HOST_PORT=5435
TELEMETRY_DB_HOST_PORT=5436
REDIS_HOST_PORT=6379

# -----------------------------------------------------------------------------
# Database-per-service credentials (Req 26.4 / 28)
# Each backend service owns a dedicated datastore + dedicated scoped user.
# -----------------------------------------------------------------------------
# Service 1 — Fleet Registry (Postgres)
FLEET_DB_USER=fleet_registry
FLEET_DB_PASSWORD=CHANGE_ME_fleet_db_password
FLEET_DB_NAME=fleet_registry

# Service 2 — Mission Planning (Postgres + PostGIS)
MISSION_DB_USER=mission_planning
MISSION_DB_PASSWORD=CHANGE_ME_mission_db_password
MISSION_DB_NAME=mission_planning

# Service 4 — Vision AI (Postgres)
VISION_DB_USER=vision_ai
VISION_DB_PASSWORD=CHANGE_ME_vision_db_password
VISION_DB_NAME=vision_ai

# Service 5 — Alert & Notification (Postgres)
ALERT_DB_USER=alert_notification
ALERT_DB_PASSWORD=CHANGE_ME_alert_db_password
ALERT_DB_NAME=alert_notification

# Service 3 — Telemetry Ingestion (TimescaleDB)
TELEMETRY_DB_USER=telemetry
TELEMETRY_DB_PASSWORD=CHANGE_ME_telemetry_db_password
TELEMETRY_DB_NAME=telemetry

# -----------------------------------------------------------------------------
# Redis (shared by Alert & Gateway; logically separated by DB index)
# -----------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password
# Alert & Notification escalation timers / state.
ALERT_REDIS_DB=0
# API Gateway rate-limit counters.
GATEWAY_REDIS_DB=1

# -----------------------------------------------------------------------------
# Telemetry anomaly-detection thresholds (Service 3)
# -----------------------------------------------------------------------------
# Descent rate (m/s) above which an ALTITUDE_DROP anomaly is flagged.
ALT_DROP_THRESHOLD=10
# Battery drain rate (%/s) above which a BATTERY_DRAIN_SPIKE anomaly is flagged.
BATTERY_DRAIN_THRESHOLD=1

# -----------------------------------------------------------------------------
# Vision AI tracking parameters (Service 4)
# -----------------------------------------------------------------------------
# Seconds a track may go unseen before it is retired from the active set.
TRACK_MAX_AGE=30
# Max centroid displacement (px/units) treated as "not moving" for vehicle_stopped.
MOVE_EPS=2.0

# -----------------------------------------------------------------------------
# Email channel — SMTP (Alert & Notification, via Nodemailer)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME_smtp_user
SMTP_PASSWORD=CHANGE_ME_smtp_password
SMTP_FROM=alerts@pawaac.example.com
SMTP_SECURE=false

# -----------------------------------------------------------------------------
# WhatsApp channel — OpenWA REST (Alert & Notification)
# -----------------------------------------------------------------------------
OPENWA_API_URL=http://localhost:8002
OPENWA_API_KEY=CHANGE_ME_openwa_api_key
OPENWA_SESSION=default

# -----------------------------------------------------------------------------
# Ops Dashboard (Next.js) — browser-facing URLs
# -----------------------------------------------------------------------------
# These point at the host-published API Gateway and are inlined into the client
# bundle at build time. Adjust if the gateway is published on a different host.
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000
