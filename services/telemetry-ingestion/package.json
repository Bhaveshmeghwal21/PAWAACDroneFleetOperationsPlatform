{
  "name": "@pawaac/telemetry-ingestion",
  "version": "0.1.0",
  "private": true,
  "description": "Service 3 — Telemetry Ingestion: high-throughput MAVLink WebSocket ingest, anomaly detection, and historical query over TimescaleDB.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathIgnorePatterns /node_modules/ '\\.e2e\\.(spec|test)\\.ts$' integration",
    "test:integration": "pnpm run build && NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPattern integration --passWithNoTests",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --testPathPattern '\\.e2e\\.(spec|test)\\.ts$' --passWithNoTests",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "migrate:up": "node-pg-migrate -m dist/migrations up",
    "migrate:down": "node-pg-migrate -m dist/migrations down",
    "migrate:create": "node-pg-migrate -m src/migrations -j ts create",
    "loadtest": "npm run build && node dist/loadtest/run.js"
  },
  "dependencies": {
    "@pawaac/shared-types": "workspace:*",
    "node-mavlink": "^2.3.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "@testcontainers/postgresql": "^10.28.0",
    "artillery": "^2.0.33",
    "fast-check": "^3.23.2",
    "jest": "^29.7.0",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3"
  }
}
