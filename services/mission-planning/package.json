{
  "name": "@pawaac/mission-planning",
  "version": "0.1.0",
  "private": true,
  "description": "Service 2 — Mission Planning: versioned mission authoring, geofence conflict detection (PostGIS), and PX4 MAVLink export.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns /node_modules/ '\\.e2e\\.spec\\.ts$' integration",
    "test:integration": "jest --runInBand --testPathPattern integration --passWithNoTests",
    "test:e2e": "jest --runInBand --testPathPattern '\\.e2e\\.spec\\.ts$' --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/typeorm": "^10.0.2",
    "@pawaac/shared-types": "workspace:*",
    "@turf/turf": "^7.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "node-mavlink": "^2.3.0",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "fast-check": "^3.23.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "testcontainers": "^10.28.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
